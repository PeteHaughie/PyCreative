"""PCGraphics shim: expose a Skia-backed PCGraphics implementation.

This module intentionally delegates to the Skia-backed implementation
(`PCGraphicsSkia`) and does not provide a Pillow-based fallback. The
project aims to be Skia-first; if Skia is not available importing or
constructing `PCGraphics` will raise so callers fail fast and tests
must opt-in to Skia.
"""
from __future__ import annotations

from typing import Any, Optional

# Prefer the Skia-backed implementation. If it isn't importable, raise
# an explicit error so callers know Skia is required for PCGraphics.
try:
    from .pcgraphics_skia import PCGraphicsSkia as _PCGS
except Exception as e:  # pragma: no cover - import-time failure
    raise ImportError("Skia-backed PCGraphics is required but could not be imported") from e


class PCGraphics(_PCGS):
    """Thin alias for the Skia-backed PCGraphics implementation.

    This keeps the public API (`core.graphics.PCGraphics`) stable while
    ensuring all behavior is provided by the Skia backend.
    """

    def __init__(self, width: int, height: int, engine: Optional[Any] = None, **kwargs):
        # Mirror PCGraphicsSkia constructor signature; allow callers to
        # pass `force_cpu` if they want to avoid GPU context creation.
        super().__init__(int(width), int(height), engine=engine, **kwargs)
